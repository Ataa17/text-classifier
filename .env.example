# Copy to .env and fill in. .env is gitignored — never commit real keys.

# YouTube Data API v3 (Google Cloud console -> APIs & Services -> Credentials)
YOUTUBE_API_KEY=

# Reddit script app (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=text-classifier:derja-sentiment:v0.1 (by /u/your_username)

# Optional: LLM pre-labeling (step 3)
ANTHROPIC_API_KEY=
